<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="  Score: 0" name="ScoreLabel" style="top: 20px; align-self: center; font-size: 20px; -unity-font-style: bold; color: rgb(72, 209, 204); border-left-color: rgb(72, 209, 204); border-right-color: rgb(72, 209, 204); border-top-color: rgb(72, 209, 204); border-bottom-color: rgb(72, 209, 204); -unity-background-image-tint-color: rgb(204, 236, 211); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px; height: 43px; width: 132px; white-space: pre; flex-direction: column;"/>
    <ui:Button text="Restart" name="RestartButton" style="top: 50%; position: absolute; align-self: center; font-size: 20px; -unity-font-style: bold; border-top-right-radius: 10px; border-top-left-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(0, 255, 255); border-right-color: rgb(0, 255, 255); border-top-color: rgb(0, 255, 255); border-bottom-color: rgb(0, 255, 255); color: rgb(255, 250, 250); background-color: rgb(72, 209, 204);"/>
